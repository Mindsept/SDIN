# Copy to app.env. This is reviewed, nonsecret shell configuration (trusted code).
# Keep platform credentials out of this file; preserve the app's bootstrap contract.
APP=myapp
SERVICES="frontend api worker"
INTEGRATION_SERVICES="api worker"
BUN_VERSION=1.3.1
REGISTRY=localhost:5000
# TAG is supplied by GitHub SHA, or by the local Git commit. Override for rollback.
FRONTEND_PORT=8000
API_PORT=8001
WORKER_HEALTH_PORT=8008
PUBLIC_BUCKET=0
LLM_VKEY=0
TEMPORAL_NS=0
ANALYTICS_SITE=0
PROVISION=1
# Optional executable migration script, relative to the application root.
MIGRATE_SCRIPT=
APP_SECRETS="postgres objectstore llm temporal analytics oidc test-users"
# For analytics provisioning, locate the separately installed core checkout:
# CORE_PLATFORM=/path/to/SDIN/td/core-platform
